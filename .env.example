# ============================================================
# ANIMA Zero — configuration template
# (No version number here. The single source of truth is src/_version.py;
#  a second copy would drift.)
# ------------------------------------------------------------
# Copy this to .env in the same directory, fill in what you need, start the backend:
#   cp .env.example .env
# Only configure the brain you actually intend to use; leave the rest empty.
# *Which* brain to use is chosen from the dropdown in the web UI, not here — here you
# only put each brain's key and address. Brain version strings live in the registry in
# src/llm/factory.py (change a version there).
# ⚠️ .env is gitignored and never committed. This template is committed.
#
# This file is English-only, deliberately: it is copied to .env and read as configuration,
# and two language variants would leave you guessing which one to copy.
# ============================================================


# ===== A. Hosted brains (need an API key and a network) =====

# --- Anthropic / Claude ---  used when you pick opus / haiku in the UI
#   opus  = Claude Opus 4.8 (strongest; $5 in / $25 out per million tokens)
#   haiku = Claude Haiku 4.5 (cheap; $1 / $5)
# Both Claude brains share this one key.
ANTHROPIC_API_KEY=

# --- OpenAI / GPT ---  used when you pick gpt-5.5 / gpt-5.4 / gpt-5.4-mini
#   gpt-5.5      = GPT-5.5 (flagship, strongest and dearest; $5 / $30)
#   gpt-5.4      = GPT-5.4 (the default brain, good value; $2.50 / $15)
#   gpt-5.4-mini = GPT-5.4-mini (cheap, good for debugging; $0.75 / $4.50)
# All three GPT brains share this one key.
OPENAI_API_KEY=


# ===== B. Local brains (through Ollama — free, offline) =====
# First install Ollama, run `ollama serve`, and pull the model below.

# Ollama's OpenAI-compatible address (localhost:11434 by default; change for another
# port or a remote host)
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- qwen3-vl ---  used when you pick qwen3-vl in the UI (currently the only local brain)
#   Run `ollama pull qwen3-vl:8b` first; if your tag differs, change the line below.
#   Qwen3-VL was chosen as the best balance of vision and tool calling available on Ollama.
#   To add another local or hosted brain, see src/llm/README.md.
ANIMA_QWEN3VL_MODEL=qwen3-vl:8b


# ===== C. World addresses (worlds are separate programs) =====
# A world — sim-chess, a MuJoCo scene, real hardware — is its own process, and
# ANIMA connects to it by URL.
# The list is name=url, comma separated.
# ⚠️ Adding a world means APPENDING an entry to this line. **Never replace what is there.**
#    (Learned on 2026-06-28: adding sim-chess replaced the line and dropped the world that
#    was there out of the menu entirely — a T0 regression.)
ANIMA_WORLDS=sim-chess=http://localhost:8102,camera=http://localhost:8104,gazebo-chess=http://localhost:8106,sim-house-nav=http://localhost:8112
# Which world to bind at startup (empty = the first one in the list)
DEFAULT_WORLD=
# Fallback addresses used when ANIMA_WORLDS is unset. The built-in default list already
# contains every world present in your checkout; these only matter if you move one.
SIM_CHESS_URL=http://localhost:8102
# camera (added in v0.3): hands a real camera's picture to ANIMA. Zero tools — it can look
# and nothing else.
CAMERA_URL=http://localhost:8104
# gazebo-chess (added in v0.4; since 2026-07-08 the code lives in the companion repo at
# open-chess-robot/sim/gazebo-chess/ and starts from there): the Gazebo physics version of
# sim-chess, where a real gripper picks up and puts down pieces. Start the episode
# simulation stack and image_bridge first. ANIMA still reaches it at the URL below.
GAZEBO_CHESS_URL=http://localhost:8106
# sim-house-nav (added in v0.9): a quadruped (Unitree Go2) navigating a three-room house —
# ANIMA identifies rooms through the dog's front camera and issues navigation primitives.
# Inside, the world runs MuJoCo physics and a learned gait policy, so the dog really walks.
# Code in world/sim-house-nav/, with its own .venv.
SIM_HOUSE_NAV_URL=http://localhost:8112

# ===== C2. Mounted services (advisers; since v0.6 ANIMA mounts these as the MCP host,
#           and worlds do not declare services) =====
# name=url, comma separated, same shape as ANIMA_WORLDS. A service is a pure-computation
# adviser, such as a board-game engine.
# ⚠️ Adding a service means APPENDING to this line, never replacing (T0, as above).
# ANIMA_SERVICES=boardgame-engine=http://localhost:8108
# Fallback address when ANIMA_SERVICES is unset (the default list already contains
# boardgame-engine; this only matters if you move it).
# ANIMA_BOARDGAME_ENGINE_URL=http://localhost:8108

# ----- gazebo-chess tunables (GZCHESS_*). Defaults live in
#       open-chess-robot/sim/gazebo-chess/config.py. These are read by the *world* process and set
#       on the side that starts the world; listed here for reference only. -----
# GZCHESS_CELL_M=0.045          # square width (default = Jeff's measured real board, 4.5 cm;
#                               #   board width derives from it as width × 8)
# GZCHESS_ARM_BOARD_GAP_M=0.10  # base axis → near physical edge of the board
# GZCHESS_BOARD_ORIGIN_X=       # override the board centre x directly (default derives from
#                               #   axis + gap + frame + half-width = 0.31)
# GZCHESS_BOARD_ORIGIN_Z=0.028  # top surface height (sits on the episode 40×80 mounting plate)
# GZCHESS_DEMO_PIECE=e2         # which square gets one demo piece at startup (used when
#                               #   SETUP_FEN is unset)
# GZCHESS_SETUP_FEN=            # position to set up (full FEN or just the placement field);
#                               #   empty = the single demo piece
# GZCHESS_REFEREE=auto          # auto (on only when a FEN was set) / on / off. On = legality
#                               #   gate before the move, ground truth, and game-over recorded
# GZCHESS_BOT_SIDE=black        # which side the built-in opponent plays (white/black/off);
#                               #   its moves teleport and do not occupy the arm
# GZCHESS_BOT_DEPTH=3           # opponent search depth; GZCHESS_BOT_TIME=2.0 seconds per move
# GZCHESS_DISCARD_MODE=bin      # captured pieces: bin = carried to a fixed point and destroyed
#                               #   (default); slots = laid out in the v0.5 slots
# GZCHESS_PIECE_MESH_DIR=       # piece meshes (default: models/meshes in the repo; set to ""
#                               #   to fall back to geometric silhouettes)
# GZCHESS_AUTO_RESET=off        # start a new game automatically after game over (default off:
#                               #   a person clicks "new game")
# GZCHESS_APPROACH_TILT_DEG=0,15,30,45,60,75   # radial tilt steps — how distant squares are
#                               #   reached; all 64 squares are reachable because of this
# GZCHESS_CAM_MODE=oblique      # oblique by default (piece shapes are legible);
#                               #   overhead = back to the v0.4 top-down view
# GZCHESS_CAM_OBL_ELEV_DEG=50   # oblique elevation; _DIST_M=0.85 distance;
#                               #   _AZIM_DEG=-90 azimuth (white's side)
# GZCHESS_FAIL_GRIP_MISS=off    # failure injection for testing recovery: off/once/always —
#                               #   grasp misses (gripper does not close, piece stays put)
# GZCHESS_FAIL_PLACE_MODE=off   # misplacement injection: off/once/always;
#                               #   GZCHESS_FAIL_PLACE_OFFSET_M=0.05
# GZCHESS_TCP_OFFSET_M=0.058    # link6 → midpoint between the fingers (adjust when grasp
#                               #   height is off)
# GZCHESS_PARK_JOINTS=2.5,0,0,0,0,0   # where the arm parks afterwards (out of the camera's way)
# Per-stage action budgets (GZCHESS_IK_TIMEOUT_S / GZCHESS_TRAJ_ACCEPT_S / GZCHESS_TRAJ_EXTRA_S
# / GZCHESS_SETTLE_S and others) cap the wait at each stage and report failure honestly when
# exceeded. The full set is in open-chess-robot/sim/gazebo-chess/config.py.


# ===== C3. World trust (the v1.1 security work) =====
# A world is a **remote process**: its guidance is joined into the brain's system prompt and
# its tool descriptions enter the tool sheet — all of it text somebody else wrote.
# So since v1.1, none of that reaches the brain until **you have read it and approved it**.
# The world still lists and still shows whether it is online; it just contributes no tools
# and no guidance. Approval binds to the **hash of the capability manifest**: change the
# manifest and you are asked again, and told what changed.
#
# To approve: click it in the web UI (the world shows as "pending"), or call the backend —
#   curl -s localhost:8000/api/worlds/sim-chess/manifest   # read what it actually declares
#   curl -sX POST localhost:8000/api/worlds/sim-chess/approve
#
# ⚠️ Development escape hatch: this skips every approval. **Local development only** — never
#    in anything shared or published. It earns its keep while you are editing your own
#    world's guidance, when the manifest changes on every save.
# ANIMA_TRUST_ALL=1
#
# Trust records live in $ANIMA_HOME/trust.json (~/.anima by default) — deliberately outside
# the repository. Someone who installed with pip has no repository, and "I reviewed this
# world and approved it" is a decision that should follow the person, not a checkout.
# ANIMA_HOME=~/.anima
#
# Length caps on a world's text before it reaches the brain. These exist for hostile or
# runaway text; a well-behaved world is nowhere near them.
# ANIMA_WORLD_GUIDANCE_MAX_CHARS=4000    # guidance; sim-house-nav measures about 844 chars
# ANIMA_WORLD_TOOL_DESC_MAX_CHARS=1000   # a single tool description


# ===== D. CORS =====
# Which web origins may reach the backend and the worlds, comma separated. `*` opens it to
# everything — convenient for a local demo, wrong for anything deployed.
ANIMA_CORS_ORIGINS=http://localhost:3000


# ===== E. Optional tuning (everything has a default; only write these to change one) =====
# -- Orchestrator / context --
# ANIMA_MAX_STEPS=60                # steps per turn. ⚠️ A seatbelt, not a metronome: ANIMA
#                                   #   decides when a turn ends by producing prose. This
#                                   #   only catches it going in circles (a chess move takes
#                                   #   2–6 steps and never comes close)
# ANIMA_TURN_TIME_BUDGET_S=900      # wall-clock per turn. A step count cannot restrain a
#                                   #   world where each step is slow (a walking robot takes
#                                   #   seconds per step); the clock is the real cost gate.
#                                   #   Reaching it is a polite pause you can continue from,
#                                   #   not an error
# ANIMA_CONTEXT_BUDGET=6000         # sliding-window token budget
# -- World client / session / AWI --
# ANIMA_WORLD_TIMEOUT=30            # deadline for reads (capabilities/perceive). Actions use
#                                   #   the liveness semantics below instead
# ANIMA_WORLD_PROBE_TIMEOUT=1.5     # short timeout for the online probe
# -- Action (invoke) liveness: reported progress extends the deadline; silence ends it;
#    and there is an absolute cap regardless --
# ANIMA_WORLD_CONNECT_TIMEOUT=5     # deadline for connecting and the MCP handshake
# ANIMA_WORLD_LIVENESS_TIMEOUT=20   # this many seconds with no sign of life (no result and
#                                   #   no progress) counts as lost
# ANIMA_WORLD_INVOKE_HARD_CAP=180   # absolute cap on one action — progress does not buy
#                                   #   unlimited time
# ANIMA_BRIDGE_WATCHDOG_POLL_S=0.25 # supervisor tick (also the cancellation response delay)
# ANIMA_BRIDGE_GRACE_S=5            # outer fallback grace period
# ANIMA_SERVICE_MCP_TIMEOUT=15      # deadline for one question to a mounted service (pure
#                                   #   computation — answers in seconds)
# ANIMA_AWI_POLL_INTERVAL_S=0.25    # AWI traffic SSE poll interval
# -- Session log caps (rarely changed; just upper bounds on what is written to disk) --
# ANIMA_LOG_MAX_SYSTEM=8000
# ANIMA_LOG_MAX_USER=8000
# ANIMA_LOG_MAX_REPLY=20000
# -- Model ids (single source of truth; change a model version here) --
# ANIMA_CLAUDE_OPUS_MODEL=claude-opus-4-8
# ANIMA_OPENAI_GPT55_MODEL=gpt-5.5
# ANIMA_OPENAI_GPT54_MODEL=gpt-5.4
# ANIMA_OPENAI_GPT54_MINI_MODEL=gpt-5.4-mini
# ANIMA_QWEN3VL_MODEL=qwen3-vl:8b
# -- boardgame-engine service (its own process on :8108; required for chess. The engine
#    cores are vendored into this repo and tuned through its own env) --
# ANIMA_ENGINE_DEPTH=3              # search depth
# ANIMA_ENGINE_TIME=1.5             # seconds per move
# -- sim-chess world (its own process and its own env. Its built-in opponent is
#    chess_bot.py, unrelated to the engine service) --
# SIMCHESS_VERSION=0.1
# SIMCHESS_BOT_DEPTH=2
# SIMCHESS_BOT_TIME=0.5
# -- camera world (its own process and env; defaults in world/camera/capture.py) --
# CAMERA_DEVICE_GLOB=/dev/video*    # glob for enumerating camera nodes (platform specific)
# CAMERA_WIDTH=640
# CAMERA_HEIGHT=480
# CAMERA_JPEG_QUALITY=80            # JPEG quality for /stream, 1-100
# CAMERA_WARMUP_READS=3             # frames to discard after opening (letting exposure settle)
# CAMERA_STREAM_FPS=15
# CAMERA_WORLD_VERSION=0.3


# ============================================================
# ⚠️ Note: tool calling (function calling) support among local vision models on Ollama is
#    uneven, and it is the most likely place for a real closed loop to fall over. Get the
#    loop working against a hosted brain (GPT-5.4-mini or Claude) first, then switch local.
# ============================================================
