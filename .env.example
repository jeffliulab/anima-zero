# ============================================================
# ANIMA Zero v0.1 —— 大脑(LLM)配置模板
# ------------------------------------------------------------
# 用法:复制成 .env(同目录),按需填写,再启动后端即可。
#   cp .env.example .env
# 只需配置你实际要用的那个大脑,其它留空;启动后端会自动读取 .env。
# 「用哪个大脑」在网页对话框里下拉选择,不在这里设;这里只放各大脑要的 key / 地址。
# 大脑的版本号写在 src/llm/factory.py 的登记表里(想换版本改那里)。
# ⚠️ .env 已在 .gitignore 中,不会入库;本模板(.env.example)可入库。
# ============================================================


# ===== A. 在线大脑(需要 API key,联网)=====

# --- Anthropic / Claude ---  网页里选 opus / haiku 时用
#   opus  = Claude Opus 4.8(最强;输入 $5 / 输出 $25 每百万 token)
#   haiku = Claude Haiku 4.5(便宜;$1 / $5)
# 两个 Claude 大脑共用下面这一个 key。
ANTHROPIC_API_KEY=

# --- OpenAI / GPT ---  网页里选 gpt-5.5 / gpt-5.4 / gpt-5.4-mini 时用
#   gpt-5.5      = GPT-5.5(旗舰,最强但贵;$5 / $30)
#   gpt-5.4      = GPT-5.4(默认大脑,性价比;$2.50 / $15)
#   gpt-5.4-mini = GPT-5.4-mini(便宜,适合调试;$0.75 / $4.50)
# 三个 GPT 大脑共用下面这一个 key。
OPENAI_API_KEY=


# ===== B. 本地大脑(经 Ollama,免费、离线)=====
# 前置:装好 Ollama 并起服务(ollama serve),再 pull 下面的模型。

# Ollama 的 OpenAI 兼容地址(默认本机 11434;换端口/远程改这里)
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- qwen3-vl ---  网页里选 qwen3-vl 时用(目前唯一的本地大脑)
#   先 `ollama pull qwen3-vl:8b`;若实际 tag 不同,改下面这行
#   选 Qwen3-VL 是因为它在 Ollama 上视觉 + 工具调用最均衡;想加别的本地/在线大脑,
#   见 src/llm/README.md《如何给 ANIMA 增加一个语言大脑》。
ANIMA_QWEN3VL_MODEL=qwen3-vl:8b


# ===== C. 世界地址(独立运行的「世界」程序)=====
# 世界(sim-desk 桌面 / sim-chess 棋具 / 以后 MuJoCo / 真机)是独立进程,anima 按 URL 连它。
# 世界清单:name=url,多个用逗号隔开。
# ⚠️ 加一个世界 = 往这一行【追加】一项,**绝不要替换掉已有的世界**
#    (2026-06-28 踩过坑:加 sim-chess 时只写了 sim-chess,把 sim-desk 挤没了 → T0 回归)。
ANIMA_WORLDS=sim-desk=http://localhost:8100,sim-chess=http://localhost:8102,camera=http://localhost:8104,gazebo-chess=http://localhost:8106,sim-house-nav=http://localhost:8112
# 启动默认绑哪个世界(留空 = 绑清单里第一个)
DEFAULT_WORLD=sim-desk
# 没设 ANIMA_WORLDS 时的回退默认地址(代码默认清单已含全部五个世界,这里只在你想改地址时用)。
SIM_DESK_URL=http://localhost:8100
SIM_CHESS_URL=http://localhost:8102
# camera 摄像头世界(v0.3 新增):把真实摄像头画面交给 ANIMA 看,零动作、只能看不能操作。
CAMERA_URL=http://localhost:8104
# gazebo-chess(v0.4 新增;2026-07-08 起代码在配套仓 soma-zero/sim/gazebo-chess/,从那边启动):sim-chess 的 Gazebo 物理版,机械臂真实夹爪抓放棋子。要先起 episode 仿真栈+image_bridge。ANIMA 仍按下面这个 URL 连它。
GAZEBO_CHESS_URL=http://localhost:8106
# sim-house-nav(v0.9 新增):三室住宅里的四足机器狗(宇树 Go2)导航——ANIMA 靠狗头前视相机认房间、发导航原语走过去。
# 世界内部跑 MuJoCo 物理+学出来的步态策略(狗真迈腿)。代码在 anima-zero/world/sim-house-nav/,自带 .venv。
SIM_HOUSE_NAV_URL=http://localhost:8112

# ===== C2. 挂载服务地址(顾问;v0.6 起由 ANIMA 按 Host 组装挂载,世界不声明服务)=====
# 服务清单:name=url,多个用逗号隔开(与 ANIMA_WORLDS 同款写法;服务=纯计算顾问,如棋类引擎)。
# ⚠️ 加一个服务 = 往这一行【追加】一项,**绝不要替换掉已有的服务**(T0,同世界清单)。
# ANIMA_SERVICES=boardgame-engine=http://localhost:8108
# 没设 ANIMA_SERVICES 时的回退默认地址(代码默认清单已含 boardgame-engine,这里只在你想改地址时用)。
# ANIMA_BOARDGAME_ENGINE_URL=http://localhost:8108

# ----- gazebo-chess 世界自带可调项(GZCHESS_*,默认值都在 soma-zero/sim/gazebo-chess/config.py;这些 env 由世界进程读、在启动世界的那一侧设,这里仅列常改项供参考) -----
# GZCHESS_CELL_M=0.045          # v0.7 格宽主项(默认=Jeff 实测真棋盘 4.5cm;板宽默认派生=格宽×8)
# GZCHESS_ARM_BOARD_GAP_M=0.10  # v0.7 底座轴心→棋盘物理近边的距离(方案 A 量法;默认 0.10)
# GZCHESS_BOARD_ORIGIN_X=       # 直接覆盖棋盘中心 x(默认按 轴心+间距+边框+半幅 派生=0.31;旧用法保留)
# GZCHESS_BOARD_ORIGIN_Z=0.028  # 棋盘上表面高度(架在 episode 40×80 安装底板顶上,别被它挡住)
# GZCHESS_DEMO_PIECE=e2         # 启动时在哪个格摆一枚演示子(不配 SETUP_FEN 时的 v0.4 路径)
# GZCHESS_SETUP_FEN=            # 摆盘 FEN(完整 FEN 或仅摆放字段);空=单演示子。整盘棋摆标准开局
# GZCHESS_REFEREE=auto          # v0.7 裁判:auto(摆了 FEN 才开)/on/off;开=前置合法闸+真值+终局落档
# GZCHESS_BOT_SIDE=black        # v0.7 内置电脑对手走哪方(white/black/off);走子瞬移不占机械臂
# GZCHESS_BOT_DEPTH=3           # 对手搜索深度;GZCHESS_BOT_TIME=2.0 单步思考秒上限
# GZCHESS_DISCARD_MODE=bin      # v0.7 吃子处理:bin=搬到固定袋点后销毁(默认);slots=v0.5 槽位摆开
# GZCHESS_PIECE_MESH_DIR=       # v0.7 棋子外观网格目录(默认仓内 models/meshes;设空串""回退几何剪影)
# GZCHESS_AUTO_RESET=off        # v0.7 终局后自动开新局(默认 off:人在网页按「开新局」)
# GZCHESS_APPROACH_TILT_DEG=0,15,30,45,60,75   # v0.7 径向倾斜档(远格靠倾斜够到;64 格可达靠它)
# GZCHESS_CAM_MODE=oblique      # v0.5 默认斜视(看得出子型);overhead=切回 v0.4 正俯视
# GZCHESS_CAM_OBL_ELEV_DEG=50   # 斜视俯角;GZCHESS_CAM_OBL_DIST_M=0.85 距离;GZCHESS_CAM_OBL_AZIM_DEG=-90 方位(白方侧)
# GZCHESS_FAIL_GRIP_MISS=off    # 失败注入(测补救链路):off/once/always——夹空(不闭爪,子留原地)
# GZCHESS_FAIL_PLACE_MODE=off   # 放偏注入:off/once/always;GZCHESS_FAIL_PLACE_OFFSET_M=0.05 偏移量
# GZCHESS_TCP_OFFSET_M=0.058    # 末端 link6→两指中点 的距离(抓取高度对不准时调这个)
# GZCHESS_PARK_JOINTS=2.5,0,0,0,0,0   # 走完把臂停到哪(让出俯视相机视野)
# 动作阶段预算(GZCHESS_IK_TIMEOUT_S / GZCHESS_TRAJ_ACCEPT_S / GZCHESS_TRAJ_EXTRA_S / GZCHESS_SETTLE_S 等,
# 每个环节的等待上限,超了如实报失败;全集见 soma-zero/sim/gazebo-chess/config.py 「动作阶段预算」一节)


# ===== D. 跨域(CORS)=====
# 允许哪些网页源访问后端 / 世界,多个用逗号隔开;设成 * 全开(demo 方便,生产别全开)。
ANIMA_CORS_ORIGINS=http://localhost:3000


# ===== E. 可选调参(都有默认值,不填即用默认;改这些才需要写) =====
# -- 编排器 / 上下文 --
# ANIMA_MAX_STEPS=60                # 单轮步数上限。⚠️ 安全带不是节拍器:一轮何时收尾由 ANIMA 自己
#                                   #   出文字决定,这个值只在它转不出来时兜底(一手棋 2-6 步碰不到)
# ANIMA_TURN_TIME_BUDGET_S=900      # 单轮墙钟上限(秒)。步数管不住「每步很慢」的世界(机器狗走一步
#                                   #   要几秒),墙钟才是真正的费用闸;到顶=礼貌停顿(可续),不是报错
# ANIMA_CONTEXT_BUDGET=6000         # 上下文滑窗 token 预算
# -- 世界客户端 / 会话 / AWI --
# ANIMA_WORLD_TIMEOUT=30            # 读操作(capabilities/perceive)的死线(秒);动作另走「生命迹象」语义(见下)
# ANIMA_WORLD_PROBE_TIMEOUT=1.5     # 探在线的短超时
# -- 动作(invoke)的「生命迹象」语义:世界报进度就续命,失联才判死,另有总上限 --
# ANIMA_WORLD_CONNECT_TIMEOUT=5     # 连上世界/MCP 握手的死线
# ANIMA_WORLD_LIVENESS_TIMEOUT=20   # 连续这么多秒无生命迹象(无结果也无进度)→判失联
# ANIMA_WORLD_INVOKE_HARD_CAP=180   # 单次动作总上限(有进度也不无限等)
# ANIMA_BRIDGE_WATCHDOG_POLL_S=0.25 # 监督器巡检步长(也是取消响应延迟)
# ANIMA_BRIDGE_GRACE_S=5            # 外层后备宽限
# ANIMA_SERVICE_MCP_TIMEOUT=15      # 挂载服务(顾问,如引擎)一次问答的死线(纯计算,秒回)
# ANIMA_AWI_POLL_INTERVAL_S=0.25    # AWI 流量 SSE 查新间隔
# -- 日志留痕(Session Logs;正常不用改,只是写盘上界) --
# ANIMA_LOG_MAX_SYSTEM=8000
# ANIMA_LOG_MAX_USER=8000
# ANIMA_LOG_MAX_REPLY=20000
# -- 模型 id(单一来源,换模型版本改这里) --
# ANIMA_CLAUDE_OPUS_MODEL=claude-opus-4-8
# ANIMA_OPENAI_GPT55_MODEL=gpt-5.5
# ANIMA_OPENAI_GPT54_MODEL=gpt-5.4
# ANIMA_OPENAI_GPT54_MINI_MODEL=gpt-5.4-mini
# ANIMA_QWEN3VL_MODEL=qwen3-vl:8b
# -- boardgame-engine service(独立进程 :8108;下棋必起。引擎内核已内聚进仓,可调项走它自带 env) --
# ANIMA_ENGINE_DEPTH=3              # 搜索深度
# ANIMA_ENGINE_TIME=1.5             # 单步时限(秒)
# -- sim-chess 世界端(世界独立进程,自己的 env;内置电脑对手=自带 chess_bot.py,与引擎服务无关) --
# SIMCHESS_VERSION=0.1
# SIMCHESS_BOT_DEPTH=2
# SIMCHESS_BOT_TIME=0.5
# -- camera 世界端(世界独立进程,自己的 env;默认值见 world/camera/capture.py) --
# CAMERA_DEVICE_GLOB=/dev/video*    # 枚举摄像头节点的路径模式(平台相关)
# CAMERA_WIDTH=640
# CAMERA_HEIGHT=480
# CAMERA_JPEG_QUALITY=80            # /stream 的 JPEG 画质 1-100
# CAMERA_WARMUP_READS=3            # 打开后先丢几帧(等自动曝光)
# CAMERA_STREAM_FPS=15
# CAMERA_WORLD_VERSION=0.3


# ============================================================
# ⚠️ 提醒:本地视觉模型经 Ollama 的「工具调用(function calling)」支持参差不齐,
#    是真脑闭环最可能翻车的地方。建议先用云端(GPT-5.4-mini / Claude)把闭环
#    验证通,再换本地。
# ============================================================
